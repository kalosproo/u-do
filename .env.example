# The Groq key is NOT a browser variable. Anything named VITE_* is inlined
# into the bundle and shipped to every visitor, so it would not be a secret.
# It lives in Cloud Functions instead:
#
#   firebase functions:secrets:set GROQ_API_KEY
#
# Get a free key (no credit card) at https://console.groq.com/keys
# To use a different model, set GROQ_MODEL in the Functions environment.

# Web push. Firebase Console > Project settings > Cloud Messaging >
# Web Push certificates > Generate key pair. Without it the reminder toggle
# says it is not configured rather than silently doing nothing.
VITE_FIREBASE_VAPID_KEY=

# The consumer app inlines the rest of the Firebase config; only the API key
# comes from the environment.
VITE_FIREBASE_API_KEY=
