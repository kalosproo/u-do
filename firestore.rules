rules_version = '2';

// U.Do Firestore rules.
//
// Workspace data (tasks, planner, expenses, habits) stays private to its owner.
// The friends feature never opens that up: it reads a separate, deliberately
// small summary document that the owner publishes for themselves.
//
// The admin console adds a second axis. Operational records — billing,
// subscriptions, payments, usage counters, activity, errors, webhooks, audit —
// are readable by an account holding the `admin` custom claim, because the
// dashboard streams them live and onSnapshot cannot run through a Function.
// Private workspace content is deliberately NOT part of that: an admin reading
// a person's account goes through a Cloud Function that returns counts and
// status, never their tasks, expenses, friend messages or AI prompts.
//
// Every collection below is written only by the Admin SDK, which bypasses these
// rules entirely. Client writes are refused across the board.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * Admin status lives in the ID token as a custom claim, which only the
     * Admin SDK can set. There is no email allowlist and no Firestore flag a
     * client could write to itself.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // The canonical username form, mirrored from services/friends.js. Any
    // ledger id outside this shape is refused, so lookups (which always
    // canonicalise first) can never miss a legitimately claimed handle.
    function isCanonicalUsername(name) {
      return name.size() >= 3 && name.size() <= 20 && name.matches('^[a-z0-9_]+$');
    }

    function ownsLedgerEntry(path, uid) {
      return exists(path) && get(path).data.uid == uid;
    }

    /**
     * A profile card may only advertise a handle and invite code this account
     * actually holds in the ledger. Without this a user could write anyone
     * else's username onto their own card and have it shown to other people
     * — friend requests carry the requester's username from here.
     */
    function cardMatchesLedger(uid) {
      return (
        !('username' in request.resource.data)
        || request.resource.data.username == ''
        || ownsLedgerEntry(/databases/$(database)/documents/usernames/$(request.resource.data.username), uid)
      ) && (
        !('inviteCode' in request.resource.data)
        || request.resource.data.inviteCode == ''
        || ownsLedgerEntry(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode), uid)
      );
    }

    // A friendship is recorded on both sides. Someone may read an owner's
    // shared card only while the owner's own friend list names them.
    function isFriendOf(ownerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(ownerId)/friends/$(request.auth.uid));
    }

    // Private workspace: tasks, planner, expenses, habits and their logs.
    // Nothing here is ever readable by another account, friend or not — and
    // that includes admins. Admin access to an account is mediated by
    // getAdminUserDetail, which returns counts rather than content.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    match /profiles/{uid} {
      // The public card: display name, handle, photo, invite code. Readable by
      // any signed-in account so that search and invite links can resolve.
      allow read: if isSignedIn();

      // Writable only by its owner, and only advertising handles they hold.
      allow write: if isOwner(uid) && cardMatchesLedger(uid);

      // Habit names, streaks and completion rates. Friends only.
      match /shared/{docId} {
        allow read: if isOwner(uid) || isFriendOf(uid);
        allow write: if isOwner(uid);
      }

      match /requests/{fromUid} {
        allow read: if isOwner(uid);

        // Anyone signed in may ask, but only ever as themselves.
        allow create: if isOwner(fromUid)
          && fromUid != uid
          && request.resource.data.uid == fromUid;

        // The recipient accepts or declines; the sender may withdraw.
        allow delete: if isOwner(uid) || isOwner(fromUid);
      }

      /**
       * The sender's own index of requests they have sent. The request itself
       * lives on the recipient and is readable only by them, so this mirror is
       * what lets a sender show "Pending" and withdraw.
       *
       * The recipient may delete it — and only delete it — so that accepting
       * or declining clears the sender's pending state instead of stranding it.
       */
      match /outgoing/{toUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == toUid;
        allow delete: if isOwner(uid) || isOwner(toUid);
      }

      match /friends/{friendUid} {
        allow read: if isOwner(uid) || isOwner(friendUid);

        // Adding someone to your own list only ever widens who may see your
        // card, so you may do it freely.
        allow create, update: if isOwner(uid);

        // The other half of an accept. This write grants friendUid sight of
        // uid's card, so it is allowed only while uid's pending request to
        // friendUid still exists to prove uid asked first. Accepting must
        // therefore write both sides before clearing the request.
        allow create: if isOwner(friendUid)
          && exists(/databases/$(database)/documents/profiles/$(friendUid)/requests/$(uid));

        // Either side can end the friendship.
        allow delete: if isOwner(uid) || isOwner(friendUid);
      }
    }

    /**
     * Handle -> uid. This collection IS the uniqueness constraint.
     *
     * `create` only applies to a document that does not exist, so a handle
     * someone already holds cannot be taken by a second account — not through
     * the app, and not by writing to Firestore directly. `update` is limited
     * to the current holder re-affirming their own entry, which stops an
     * existing entry being repointed at anyone else. Reads return only a uid,
     * so checking whether a handle is free reveals nothing else about its
     * owner.
     */
    match /usernames/{username} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isCanonicalUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Invite code -> uid, under the same first-come rules as handles.
    match /inviteCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Written by the auth Cloud Function through the Admin SDK, which bypasses
    // these rules entirely. No client should ever reach it.
    match /authRateLimits/{document} {
      allow read, write: if false;
    }

    /**
     * Consent records: which version of the privacy policy an account accepted,
     * and when.
     *
     * Written by the client, because accepting a policy is something a person
     * does in a browser and there is no server round trip at signup to carry
     * it. The rules pin each record to the account writing it, so the only
     * thing anyone can misstate here is their own agreement.
     *
     * There is no delete path, from any caller. A consent record that the
     * consenting party can erase is not a record.
     */
    match /consents/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.privacyVersion is int;

      allow delete: if false;
    }

    // ---------------------------------------------------------------- billing

    /**
     * One record per account: which plan they are on and what their
     * subscription is doing. The owner may read their own so the app can show
     * a plan badge; only the server writes, so nobody can promote themselves
     * to Pro from the console.
     */
    match /billing/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    /**
     * Server-authoritative quota counters. Read by the owner so the app can
     * show "12 of 30 used"; never client-writable, because a counter a user
     * can reset is not a limit.
     */
    match /usageCounters/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    /**
     * The published plan table. Any signed-in account may read it so the app
     * can show what Free includes and what Pro adds. Written only by
     * seedPlanLimits.
     */
    match /planLimits/{planId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Razorpay subscription and payment mirrors. Safe metadata only — no keys,
    // no signatures, no raw webhook bodies are ever written into these.
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------ operational

    // Pre-aggregated counters the Overview reads without scanning anything.
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The live feed on the Overview. Event type and target only, never the
    // content of what a person wrote.
    match /activityEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Function failures and critical errors. Stack traces are admin-only.
    match /errorLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Razorpay webhook receipts: event id, type, status, retry count and
    // timing. The signed payload itself is never mirrored here.
    match /webhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /**
     * Append-only. Nothing in the codebase updates or deletes an entry, and
     * rules refuse every client write, so the only way in is the Admin SDK
     * writing a new document.
     */
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
