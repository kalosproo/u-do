rules_version = '2';

// U.Do Firestore rules.
//
// Workspace data (tasks, planner, expenses, habits) stays private to its owner.
// The friends feature never opens that up: it reads a separate, deliberately
// small summary document that the owner publishes for themselves.
//
// The admin console adds a second axis. Operational records — billing,
// subscriptions, payments, usage counters, activity, errors, webhooks, audit —
// are readable by an account holding the `admin` custom claim, because the
// dashboard streams them live and onSnapshot cannot run through a Function.
// Private workspace content is deliberately NOT part of that: an admin reading
// a person's account goes through a Cloud Function that returns counts and
// status, never their tasks, expenses, friend messages or AI prompts.
//
// Every collection below is written only by the Admin SDK, which bypasses these
// rules entirely. Client writes are refused across the board.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * Admin status lives in the ID token as a custom claim, which only the
     * Admin SDK can set. There is no email allowlist and no Firestore flag a
     * client could write to itself.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // The canonical username form, mirrored from services/friends.js. Any
    // ledger id outside this shape is refused, so lookups (which always
    // canonicalise first) can never miss a legitimately claimed handle.
    function isCanonicalUsername(name) {
      return name.size() >= 3 && name.size() <= 20 && name.matches('^[a-z0-9_]+$');
    }

    function ownsLedgerEntry(path, uid) {
      return exists(path) && get(path).data.uid == uid;
    }

    /**
     * A profile card may only advertise a handle and invite code this account
     * actually holds in the ledger. Without this a user could write anyone
     * else's username onto their own card and have it shown to other people
     * — friend requests carry the requester's username from here.
     */
    function cardMatchesLedger(uid) {
      return (
        !('username' in request.resource.data)
        || request.resource.data.username == ''
        || ownsLedgerEntry(/databases/$(database)/documents/usernames/$(request.resource.data.username), uid)
      ) && (
        !('inviteCode' in request.resource.data)
        || request.resource.data.inviteCode == ''
        || ownsLedgerEntry(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode), uid)
      );
    }

    // A friendship is recorded on both sides. Someone may read an owner's
    // shared card only while the owner's own friend list names them.
    function isFriendOf(ownerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(ownerId)/friends/$(request.auth.uid));
    }

    /**
     * A transaction, checked field by field.
     *
     * `amountMinor` is an integer count of the currency's smallest unit, and
     * the only figure the app treats as the amount. `amount` is the same
     * number in major units, kept so a client running the bundle that predates
     * minor units still reads something correct; it is bounded here as well,
     * because the reader prefers it when the two disagree and an unbounded
     * mirror would walk straight past the bound on the field beside it.
     *
     * This deliberately does not use hasOnly(). Records written by earlier
     * versions carry fields these rules were never told about, and refusing
     * them would leave someone unable to edit their own row — a worse outcome
     * than a stray key. What is checked is checked strictly.
     */
    function validExpense(data) {
      return data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 10000000000
        && data.amount is number
        && data.amount > 0
        && data.amount <= 100000000
        && data.currency in ['INR']
        && data.type in ['expense', 'income']
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 60
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    /**
     * Tasks, plans and habits carry no money, so these check shape and size
     * rather than value: every field the app writes is the right type and
     * bounded, so nobody can store a 10 MB title or turn a habit's log into
     * a list of a million entries.
     *
     * The bounds are generous on purpose. The app caps titles at 200
     * characters; the rules allow 500, so a record written before any cap
     * existed can still be edited. Like the expense rules, unknown extra
     * fields are tolerated rather than locking someone out of their own row.
     */
    function boundedDoc(data) {
      return data.keys().size() <= 40;
    }

    function label(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }

    function optionalOf(data, field, kind) {
      return !(field in data)
        || data[field] == null
        || (kind == 'bool' && data[field] is bool)
        || (kind == 'number' && data[field] is number)
        || (kind == 'map' && data[field] is map);
    }

    function validExam(data) {
      return data.keys().hasOnly(['title', 'date', 'subject', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && label(data, 'subject', 40);
    }

    function validClass(data) {
      return data.keys().hasOnly(['subject', 'day', 'start', 'end', 'room', 'createdAt', 'updatedAt'])
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 40
        && data.day is int && data.day >= 0 && data.day <= 6
        && data.start is string && data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.end is string && data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.end > data.start
        && label(data, 'room', 30);
    }

    function validGrade(data) {
      return data.keys().hasOnly(['subject', 'title', 'score', 'outOf', 'weight', 'date', 'createdAt', 'updatedAt'])
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 40
        && label(data, 'title', 80)
        && data.score is number && data.score >= 0
        && data.outOf is number && data.outOf > 0 && data.outOf <= 1000 && data.score <= data.outOf
        && (!('weight' in data) || (data.weight is number && data.weight > 0 && data.weight <= 100))
        && (!('date' in data) || (data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    function validFocusDay(dayKey, data) {
      return data.keys().hasOnly(['date', 'minutes', 'sessions', 'subjects', 'updatedAt'])
        && dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.date == dayKey
        && data.minutes is int && data.minutes >= 0 && data.minutes <= 1440
        && data.sessions is int && data.sessions >= 0 && data.sessions <= 200
        && (!('subjects' in data) || (data.subjects is map && data.subjects.size() <= 30));
    }

    function validTask(data) {
      return boundedDoc(data)
        && label(data, 'title', 500)
        && label(data, 'status', 20)
        && label(data, 'priority', 20)
        && label(data, 'dueDate', 10)
        && label(data, 'dueTime', 5)
        // A one-off task has seriesId null; only a repeating one carries an id.
        && (!('seriesId' in data) || data.seriesId == null || label(data, 'seriesId', 100))
        && optionalOf(data, 'completed', 'bool')
        && optionalOf(data, 'leadMinutes', 'number')
        && optionalOf(data, 'repeat', 'map')
        && (!('subtasks' in data) || (data.subtasks is list && data.subtasks.size() <= 30))
        && (!('repeat' in data) || data.repeat == null || data.repeat.size() <= 10);
    }

    function validPlan(data) {
      return boundedDoc(data)
        && label(data, 'title', 500)
        && label(data, 'date', 10)
        && label(data, 'priority', 20)
        && optionalOf(data, 'completed', 'bool')
        && optionalOf(data, 'order', 'number');
    }

    function validHabit(data) {
      return boundedDoc(data)
        && label(data, 'title', 500)
        && label(data, 'frequency', 20)
        && optionalOf(data, 'logs', 'map')
        // Ten years of daily ticks, with room to spare.
        && (!('logs' in data) || data.logs == null || data.logs.size() <= 4000);
    }

    // Private workspace: tasks, planner, expenses and habits.
    // Nothing here is ever readable by another account, friend or not — and
    // that includes admins. Admin access to an account is mediated by
    // getAdminUserDetail, which returns counts rather than content.
    //
    // The four collections are written out rather than covered by one
    // recursive wildcard. Rules are OR'd, so a `users/{uid}/{document=**}`
    // that allows any write would have granted every expense write on its own
    // and made the validation below dead code. Naming them also closes the
    // door on a client inventing a fifth collection under someone's account.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /expenses/{entryId} {
        allow read, delete: if isOwner(uid);

        // request.resource.data is the whole document after the write, for a
        // partial update as much as a create, so one check covers both.
        allow create, update: if isOwner(uid) && validExpense(request.resource.data);
      }

      match /tasks/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTask(request.resource.data);
      }

      match /planner/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPlan(request.resource.data);
      }

      match /habits/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validHabit(request.resource.data);
      }

      // Exam countdowns: a title, a date, and the subject focus time counts toward.
      match /exams/{examId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validExam(request.resource.data);
      }

      // The weekly class timetable.
      match /classes/{classId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validClass(request.resource.data);
      }

      // Marks per subject, for the grade tracker.
      match /grades/{gradeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGrade(request.resource.data);
      }

      // One record per day of focus-timer time. Owner only, like the rest of
      // the workspace; friends never see these.
      match /focus/{dayKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validFocusDay(dayKey, request.resource.data);
      }
    }

    match /profiles/{uid} {
      // The public card: display name, handle, photo, invite code. Readable by
      // any signed-in account so that search and invite links can resolve.
      allow read: if isSignedIn();

      // Writable only by its owner, and only advertising handles they hold.
      allow write: if isOwner(uid) && cardMatchesLedger(uid);

      // Habit names, streaks and completion rates. Friends only.
      match /shared/{docId} {
        allow read: if isOwner(uid) || isFriendOf(uid);
        allow write: if isOwner(uid);
      }

      match /requests/{fromUid} {
        allow read: if isOwner(uid);

        // Anyone signed in may ask, but only ever as themselves.
        allow create: if isOwner(fromUid)
          && fromUid != uid
          && request.resource.data.uid == fromUid;

        // The recipient accepts or declines; the sender may withdraw.
        allow delete: if isOwner(uid) || isOwner(fromUid);
      }

      /**
       * The sender's own index of requests they have sent. The request itself
       * lives on the recipient and is readable only by them, so this mirror is
       * what lets a sender show "Pending" and withdraw.
       *
       * The recipient may delete it — and only delete it — so that accepting
       * or declining clears the sender's pending state instead of stranding it.
       */
      match /outgoing/{toUid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.uid == toUid;
        allow delete: if isOwner(uid) || isOwner(toUid);
      }

      /**
       * Study room invites. Only a friend may invite you, only to a room they
       * host, and only as themselves. You decline by deleting it; whoever
       * hosts the room now withdraws it when they remove you or close it.
       */
      match /studyInvites/{roomId} {
        allow read: if isOwner(uid);
        allow create: if isSignedIn()
          && request.auth.uid != uid
          && isFriendOf(uid)
          && request.resource.data.keys().hasOnly(['host', 'hostName', 'createdAt'])
          && request.resource.data.host == request.auth.uid
          && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 60
          && hostsRoom(roomId);
        allow delete: if isOwner(uid) || (isSignedIn() && resource.data.host == request.auth.uid) || hostsRoom(roomId);
      }

      match /friends/{friendUid} {
        // Your friends may see who else you're friends with, which is what
        // lets the app show mutual friends. Strangers still cannot.
        allow read: if isOwner(uid) || isOwner(friendUid) || isFriendOf(uid);

        // Adding someone to your own list only ever widens who may see your
        // card, so you may do it freely.
        allow create, update: if isOwner(uid);

        // The other half of an accept. This write grants friendUid sight of
        // uid's card, so it is allowed only while uid's pending request to
        // friendUid still exists to prove uid asked first. Accepting must
        // therefore write both sides before clearing the request.
        allow create: if isOwner(friendUid)
          && exists(/databases/$(database)/documents/profiles/$(friendUid)/requests/$(uid));

        // Either side can end the friendship.
        allow delete: if isOwner(uid) || isOwner(friendUid);
      }
    }

    /**
     * Handle -> uid. This collection IS the uniqueness constraint.
     *
     * `create` only applies to a document that does not exist, so a handle
     * someone already holds cannot be taken by a second account — not through
     * the app, and not by writing to Firestore directly. `update` is limited
     * to the current holder re-affirming their own entry, which stops an
     * existing entry being repointed at anyone else. Reads return only a uid,
     * so checking whether a handle is free reveals nothing else about its
     * owner.
     */
    match /usernames/{username} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && isCanonicalUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Invite code -> uid, under the same first-come rules as handles.
    match /inviteCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Written by the auth Cloud Function through the Admin SDK, which bypasses
    // these rules entirely. No client should ever reach it.
    match /authRateLimits/{document} {
      allow read, write: if false;
    }

    /**
     * Consent records: which version of the privacy policy an account accepted,
     * and when.
     *
     * Written by the client, because accepting a policy is something a person
     * does in a browser and there is no server round trip at signup to carry
     * it. The rules pin each record to the account writing it, so the only
     * thing anyone can misstate here is their own agreement.
     *
     * There is no delete path, from any caller. A consent record that the
     * consenting party can erase is not a record.
     */
    match /consents/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.privacyVersion is int;

      allow delete: if false;
    }

    /**
     * Push tokens and reminder preferences.
     *
     * Owner-only, and deliberately not readable by admins: a push token is a
     * device identifier, the console has no use for one, and the privacy
     * policy says the token is used for nothing but the reminders the person
     * asked for. Keeping it out of every other reader is how that stays true.
     *
     * The server prunes dead tokens through the Admin SDK, which bypasses
     * these rules.
     */
    /**
     * The daily summary email: on or off, what time, which zone. Owner only.
     * lastSentDay is written by the server so the summary goes once a day.
     */
    // Switches the owner flips in the console (e.g. appConfig/email once the
    // email provider is set up). Readable so the app knows what to offer.
    match /appConfig/{name} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /emailPrefs/{uid} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'daily', 'monthly', 'time', 'timeZone', 'updatedAt', 'lastSentDay', 'lastMonthlySent'])
        && request.resource.data.uid == uid
        && request.resource.data.daily is bool
        && (!('monthly' in request.resource.data) || request.resource.data.monthly is bool)
        && (!('time' in request.resource.data) || (request.resource.data.time is string && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')))
        && (!('timeZone' in request.resource.data) || (request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 64));
    }

    /**
     * Group study rooms. The host invites friends; everyone in the room runs
     * the host's timer. A room holds the timer, the host's name and who was
     * invited — never what anyone is studying. An invite, written under the
     * invitee's profile, is what lets them see the room; so does still being
     * in it, which is how a host who handed over keeps their seat.
     */
    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function hostsRoom(roomId) {
      return isSignedIn() && get(roomPath(roomId)).data.host == request.auth.uid;
    }

    function invitedTo(roomId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)/studyInvites/$(roomId));
    }

    function inRoom(roomId) {
      return isSignedIn() && exists(memberPath(roomId, request.auth.uid));
    }

    function validRoom() {
      let d = request.resource.data;
      return d.keys().hasOnly(['host', 'hostName', 'invited', 'state', 'endsAt', 'left', 'minutes', 'createdAt', 'updatedAt'])
        && d.hostName is string && d.hostName.size() <= 60
        && d.invited is list && d.invited.size() <= 10
        && d.state in ['idle', 'focus', 'paused']
        && d.minutes is int && d.minutes >= 1 && d.minutes <= 180
        && (d.endsAt == null || d.endsAt is int)
        && (d.left == null || d.left is int);
    }

    // Handing over changes who hosts and nothing else.
    function onlyHostChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['host', 'hostName', 'updatedAt']);
    }

    // The host is gone: they left, or their app stopped checking in.
    function hostGone(roomId) {
      let hostSeat = memberPath(roomId, resource.data.host);
      return !exists(hostSeat)
        || !('seenAt' in get(hostSeat).data)
        || get(hostSeat).data.seenAt < request.time - duration.value(90, 's');
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && (resource.data.host == request.auth.uid || invitedTo(roomId) || inRoom(roomId));
      allow create: if isSignedIn() && validRoom() && request.resource.data.host == request.auth.uid;
      allow update: if isSignedIn() && validRoom() && (
        // The host runs the room.
        (resource.data.host == request.auth.uid && request.resource.data.host == request.auth.uid)
        // The host hands it to someone still in the room.
        || (resource.data.host == request.auth.uid && onlyHostChanges()
            && exists(memberPath(roomId, request.resource.data.host)))
        // Someone in the room takes over from a host who is gone.
        || (request.resource.data.host == request.auth.uid && onlyHostChanges()
            && inRoom(roomId) && hostGone(roomId))
      );
      allow delete: if isSignedIn() && resource.data.host == request.auth.uid;

      // Who has joined. Each person adds and removes only themselves; the
      // host removes someone, or clears everyone when the room closes.
      // `session` names the one device someone is on the call from.
      match /members/{memberUid} {
        allow read: if hostsRoom(roomId) || invitedTo(roomId) || inRoom(roomId);
        allow create, update: if isOwner(memberUid)
          && (hostsRoom(roomId) || invitedTo(roomId) || inRoom(roomId))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'joinedAt', 'reaction', 'reactedAt', 'seenAt', 'session', 'cam', 'mic'])
          && request.resource.data.uid == memberUid
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          // Reactions are one of a fixed few icons, never free text.
          && (!('reaction' in request.resource.data)
              || request.resource.data.reaction in ['thumbs', 'zap', 'coffee', 'star', 'heart', 'moon'])
          && (!('session' in request.resource.data) || request.resource.data.session == null
              || (request.resource.data.session is string && request.resource.data.session.size() <= 40))
          && (!('cam' in request.resource.data) || request.resource.data.cam is bool)
          && (!('mic' in request.resource.data) || request.resource.data.mic is bool);
        allow delete: if isOwner(memberUid) || hostsRoom(roomId);
      }

      /**
       * Video call signalling between two devices in the room: the offer,
       * the answer, then network candidates. Only the two people on a link
       * can read or write it; the media itself goes device to device and
       * never passes through here.
       */
      match /links/{linkId} {
        // Someone in the room may wait for a link that doesn't exist yet.
        allow read: if isSignedIn() && (
          (resource == null && inRoom(roomId))
          || (resource != null && (request.auth.uid in resource.data.users || hostsRoom(roomId))));
        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly(['users', 'sessions', 'offer', 'answer', 'createdAt'])
          && request.resource.data.users is list && request.resource.data.users.size() == 2
          && request.auth.uid in request.resource.data.users
          && exists(memberPath(roomId, request.resource.data.users[0]))
          && exists(memberPath(roomId, request.resource.data.users[1]))
          && request.resource.data.sessions is list && request.resource.data.sessions.size() == 2
          && validSdp(request.resource.data.offer) && request.resource.data.answer == null;
        allow update: if isSignedIn() && request.auth.uid in resource.data.users
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offer', 'answer'])
          && validSdp(request.resource.data.offer) && validSdp(request.resource.data.answer);
        allow delete: if isSignedIn() && (request.auth.uid in resource.data.users || hostsRoom(roomId));

        match /ice/{iceId} {
          allow read, delete: if isSignedIn()
            && (request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)/links/$(linkId)).data.users
                || hostsRoom(roomId));
          allow create: if isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)/links/$(linkId)).data.users
            && request.resource.data.keys().hasOnly(['from', 'c', 'at'])
            && request.resource.data.from is string && request.resource.data.from.size() <= 40
            && request.resource.data.c is string && request.resource.data.c.size() <= 2000;
        }
      }
    }

    // Your own seat in any room, so each of your devices can find the room
    // you're in. It shows nothing about anyone else.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function validSdp(value) {
      return value == null
        || (value is map && value.keys().hasOnly(['type', 'sdp'])
            && value.type in ['offer', 'answer'] && value.sdp is string && value.sdp.size() <= 60000);
    }

    match /pushSubscriptions/{uid} {
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;

      // Turning reminders off clears the record entirely if the client wants.
      allow delete: if isOwner(uid);
    }

    // ---------------------------------------------------------------- billing

    /**
     * One record per account: which plan they are on and what their
     * subscription is doing. The owner may read their own so the app can show
     * a plan badge; only the server writes, so nobody can promote themselves
     * to Pro from the console.
     */
    match /billing/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    /**
     * Server-authoritative quota counters. Read by the owner so the app can
     * show "12 of 30 used"; never client-writable, because a counter a user
     * can reset is not a limit.
     */
    match /usageCounters/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    /**
     * The published plan table. Any signed-in account may read it so the app
     * can show what Free includes and what Pro adds. Written only by
     * seedPlanLimits.
     */
    match /planLimits/{planId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Razorpay subscription and payment mirrors. Safe metadata only — no keys,
    // no signatures, no raw webhook bodies are ever written into these.
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------ operational

    // Pre-aggregated counters the Overview reads without scanning anything.
    match /stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The live feed on the Overview. Event type and target only, never the
    // content of what a person wrote.
    match /activityEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Function failures and critical errors. Stack traces are admin-only.
    match /errorLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Razorpay webhook receipts: event id, type, status, retry count and
    // timing. The signed payload itself is never mirrored here.
    match /webhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /**
     * Append-only. Nothing in the codebase updates or deletes an entry, and
     * rules refuse every client write, so the only way in is the Admin SDK
     * writing a new document.
     */
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
