# Same Firebase project as the consumer app (u-do-0). The admin app is a
# separate Vercel project, so it needs its own copy of these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=u-do-0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=u-do-0
VITE_FIREBASE_STORAGE_BUCKET=u-do-0.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=368334460810
VITE_FIREBASE_APP_ID=

# Optional: point at the local emulator suite during development.
VITE_USE_EMULATORS=false
